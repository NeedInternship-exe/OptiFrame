{
  "name": "optiframe",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "OptiFrame - des verres recyclés à la monture imprimée en 3D (web app mobile)",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "bench": "node --experimental-strip-types bench/run.ts",
    "test": "node --experimental-strip-types bench/test-frame.ts"
  },
  "dependencies": {
    "manifold-3d": "^3.5.4",
    "onnxruntime-web": "^1.30.0",
    "preact": "^11.0.0",
    "qrcode": "^1.5.4",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.6",
    "@types/node": "^26.6.4",
    "@types/qrcode": "^1.5.6",
    "@types/three": "^0.186.0",
    "jpeg-js": "^0.4.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.2",
    "vite-plugin-pwa": "^2.0.0"
  }
}
